msgctxt "#11401"
msgid "Resonance setup"
msgstr "Resonance-setup"

msgctxt "#11402"
msgid "Welcome to Resonance.\n\nSetup takes a few minutes: a Spotify app Client ID, pairing this box for playback, and signing in to Spotify."
msgstr "Welkom bij Resonance.\n\nDe setup duurt een paar minuten: een Spotify Client ID, dit apparaat koppelen voor afspelen en inloggen bij Spotify."

msgctxt "#11403"
msgid "Continue Resonance setup?\n\nSteps you already finished are skipped."
msgstr "Resonance-setup voortzetten?\n\nStappen die je al hebt afgerond, worden overgeslagen."

msgctxt "#11404"
msgid "Start"
msgstr "Start"

msgctxt "#11405"
msgid "Skip"
msgstr "Overslaan"

msgctxt "#11406"
msgid "Step 1 of 3: Spotify app"
msgstr "Stap 1 van 3: Spotify-app"

msgctxt "#11407"
msgid "Create a free app at developer.spotify.com/dashboard and add this Redirect URI:\n\n{}\n\nNext, enter the app's 32-character Client ID."
msgstr "Maak een gratis app aan op developer.spotify.com/dashboard en voeg deze Redirect URI toe:\n\n{}\n\nVul daarna de Client ID van 32 tekens van de app in."

msgctxt "#11408"
msgid "Spotify Client ID"
msgstr "Spotify Client ID"

msgctxt "#11409"
msgid "That is not a valid Client ID. Run guided setup again from Settings."
msgstr "Dat is geen geldige Client ID. Start de begeleide setup opnieuw via Instellingen."

msgctxt "#11410"
msgid "Step 2 of 3: Playback"
msgstr "Stap 2 van 3: Afspelen"

msgctxt "#11411"
msgid "Playback needs this box paired with Spotify once. The next screen waits for it."
msgstr "Afspelen vereist eenmalig een koppeling van dit apparaat met Spotify. Het volgende scherm wacht daarop."

msgctxt "#11412"
msgid "Step 3 of 3: Sign in"
msgstr "Stap 3 van 3: Inloggen"

msgctxt "#11413"
msgid "Sign in with Spotify in your browser for search and playlists."
msgstr "Log in bij Spotify in je browser voor zoeken en playlists."

msgctxt "#11414"
msgid "Setup complete. Search, playlists and playback are ready."
msgstr "Setup voltooid. Zoeken, playlists en afspelen zijn klaar."

msgctxt "#11415"
msgid "Waiting for Spotify to pair...\n\nOn your phone or PC, open Spotify, tap the speaker icon, and pick '{}'."
msgstr "Wachten tot Spotify koppelt...\n\nOpen Spotify op je telefoon of pc, tik op het speakerpictogram en kies '{}'."

msgctxt "#11416"
msgid "Not paired yet.\n\nOn your phone or PC, open Spotify, tap the speaker icon, and pick '{}'. Then retry."
msgstr "Nog niet gekoppeld.\n\nOpen Spotify op je telefoon of pc, tik op het speakerpictogram en kies '{}'. Probeer het daarna opnieuw."

msgctxt "#11417"
msgid "Not paired yet. Open Spotify, tap the speaker icon, pick '{}', then try again."
msgstr "Nog niet gekoppeld. Open Spotify, tik op het speakerpictogram, kies '{}' en probeer het opnieuw."

msgctxt "#11418"
msgid "Retry"
msgstr "Opnieuw proberen"

msgctxt "#11419"
msgid "Cancel"
msgstr "Annuleren"

msgctxt "#11420"
msgid "Next: enter your Spotify Client ID"
msgstr "Volgende: vul je Spotify Client ID in"

msgctxt "#11421"
msgid "Next: pair playback with Spotify"
msgstr "Volgende: koppel het afspelen met Spotify"

msgctxt "#11422"
msgid "Next: sign in for search and playlists"
msgstr "Volgende: log in voor zoeken en playlists"

msgctxt "#11423"
msgid "Reset Resonance"
msgstr "Resonance resetten"

msgctxt "#11424"
msgid "Clears Spotify sign-in, playback pairing, cache and setup choices. A backup is kept. Restart Kodi afterwards."
msgstr "Wist de Spotify-inlog, afspeelkoppeling, cache en setupkeuzes. Er wordt een back-up bewaard. Herstart Kodi daarna."

msgctxt "#11425"
msgid "Reset Resonance? Spotify sign-in, playback pairing, the cache and setup choices are cleared. A backup is kept in the add-on data folder. Restart Kodi afterwards to finish."
msgstr "Resonance resetten? De Spotify-inlog, afspeelkoppeling, cache en setupkeuzes worden gewist. Er wordt een back-up bewaard in de map van de add-on. Herstart Kodi daarna om af te ronden."

msgctxt "#11426"
msgid "Resonance was reset. Restart Kodi, then run guided setup."
msgstr "Resonance is gereset. Herstart Kodi en start daarna de begeleide setup."

msgctxt "#11427"
