msgstr "{}: servicio no disponible"

msgctxt "#11401"
msgid "Resonance setup"
msgstr "Configuración de Resonance"

msgctxt "#11402"
msgid "Welcome to Resonance.\n\nSetup takes a few minutes: a Spotify app Client ID, pairing this box for playback, and signing in to Spotify."
msgstr "Bienvenido a Resonance.\n\nLa configuración tarda unos minutos: un Client ID de Spotify, vincular este equipo para la reproducción e iniciar sesión en Spotify."

msgctxt "#11403"
msgid "Continue Resonance setup?\n\nSteps you already finished are skipped."
msgstr "¿Continuar la configuración de Resonance?\n\nLos pasos que ya terminaste se omiten."

msgctxt "#11404"
msgid "Start"
msgstr "Empezar"

msgctxt "#11405"
msgid "Skip"
msgstr "Omitir"

msgctxt "#11406"
msgid "Step 1 of 3: Spotify app"
msgstr "Paso 1 de 3: app de Spotify"

msgctxt "#11407"
msgid "Create a free app at developer.spotify.com/dashboard and add this Redirect URI:\n\n{}\n\nNext, enter the app's 32-character Client ID."
msgstr "Crea una app gratuita en developer.spotify.com/dashboard y añade esta Redirect URI:\n\n{}\n\nDespués, introduce el Client ID de 32 caracteres de la app."

msgctxt "#11408"
msgid "Spotify Client ID"
msgstr "Client ID de Spotify"

msgctxt "#11409"
msgid "That is not a valid Client ID. Run guided setup again from Settings."
msgstr "Ese no es un Client ID válido. Vuelve a ejecutar la configuración guiada desde Ajustes."

msgctxt "#11410"
msgid "Step 2 of 3: Playback"
msgstr "Paso 2 de 3: reproducción"

msgctxt "#11411"
msgid "Playback needs this box paired with Spotify once. The next screen waits for it."
msgstr "La reproducción necesita vincular este equipo con Spotify una vez. La siguiente pantalla espera a que lo hagas."

msgctxt "#11412"
msgid "Step 3 of 3: Sign in"
msgstr "Paso 3 de 3: iniciar sesión"

msgctxt "#11413"
msgid "Sign in with Spotify in your browser for search and playlists."
msgstr "Inicia sesión en Spotify en tu navegador para la búsqueda y las listas."

msgctxt "#11414"
msgid "Setup complete. Search, playlists and playback are ready."
msgstr "Configuración completada. La búsqueda, las listas y la reproducción están listas."

msgctxt "#11415"
msgid "Waiting for Spotify to pair...\n\nOn your phone or PC, open Spotify, tap the speaker icon, and pick '{}'."
msgstr "Esperando a que Spotify se vincule...\n\nEn tu teléfono o PC, abre Spotify, toca el icono del altavoz y elige '{}'."

msgctxt "#11416"
msgid "Not paired yet.\n\nOn your phone or PC, open Spotify, tap the speaker icon, and pick '{}'. Then retry."
msgstr "Aún no vinculado.\n\nEn tu teléfono o PC, abre Spotify, toca el icono del altavoz y elige '{}'. Luego inténtalo de nuevo."

msgctxt "#11417"
msgid "Not paired yet. Open Spotify, tap the speaker icon, pick '{}', then try again."
msgstr "Aún no vinculado. Abre Spotify, toca el icono del altavoz, elige '{}' e inténtalo de nuevo."

msgctxt "#11418"
msgid "Retry"
msgstr "Reintentar"

msgctxt "#11419"
msgid "Cancel"
msgstr "Cancelar"

msgctxt "#11420"
msgid "Next: enter your Spotify Client ID"
msgstr "Siguiente: introduce tu Client ID de Spotify"

msgctxt "#11421"
msgid "Next: pair playback with Spotify"
msgstr "Siguiente: vincula la reproducción con Spotify"

msgctxt "#11422"
msgid "Next: sign in for search and playlists"
msgstr "Siguiente: inicia sesión para la búsqueda y las listas"

msgctxt "#11423"
msgid "Reset Resonance"
msgstr "Restablecer Resonance"

msgctxt "#11424"
msgid "Clears Spotify sign-in, playback pairing, cache and setup choices. A backup is kept. Restart Kodi afterwards."
msgstr "Borra el inicio de sesión de Spotify, la vinculación de reproducción, la caché y las opciones de configuración. Se conserva una copia de seguridad. Reinicia Kodi después."

msgctxt "#11425"
msgid "Reset Resonance? Spotify sign-in, playback pairing, the cache and setup choices are cleared. A backup is kept in the add-on data folder. Restart Kodi afterwards to finish."
msgstr "¿Restablecer Resonance? Se borran el inicio de sesión de Spotify, la vinculación de reproducción, la caché y las opciones de configuración. Se guarda una copia de seguridad en la carpeta de datos del complemento. Reinicia Kodi después para terminar."

msgctxt "#11426"
msgid "Resonance was reset. Restart Kodi, then run guided setup."
msgstr "Resonance se ha restablecido. Reinicia Kodi y luego ejecuta la configuración guiada."

msgctxt "#11427"
msgid "Reset"
msgstr "Restablecer"

msgctxt "#11428"
msgid "Guided setup is already running."
msgstr "La configuración guiada ya está en marcha."

msgctxt "#11429"
msgid "Spotify Client ID saved."
msgstr "Client ID de Spotify guardado."

msgctxt "#11430"
msgid "The Client ID was not saved. It must be the 32 letters and numbers from your Spotify app. Run guided setup again to retry."
msgstr "El Client ID no se guardó. Debe tener las 32 letras y números de tu app de Spotify. Vuelve a ejecutar la configuración guiada para intentarlo."

msgctxt "#11431"
msgid "Playback is paired with Spotify as '{}'."
msgstr "La reproducción está vinculada a Spotify como '{}'."

msgctxt "#11432"
msgid "Playback is not paired yet. Run guided setup again to finish pairing."
msgstr "La reproducción aún no está vinculada. Vuelve a ejecutar la configuración guiada para terminar la vinculación."

msgctxt "#11433"
msgid "Signed in to Spotify. Search and playlists are ready."
msgstr "Sesión iniciada en Spotify. La búsqueda y las listas están listas."

msgctxt "#11434"
msgid "Browser sign-in did not finish. Run guided setup again to finish it."
msgstr "El inicio de sesión en el navegador no se completó. Vuelve a ejecutar la configuración guiada para terminarlo."

msgctxt "#11435"
msgid "Setup summary"
msgstr "Resumen de la configuración"

msgctxt "#11436"
msgid "Done"
msgstr "Hecho"

msgctxt "#11437"
msgid "Not done"
msgstr "No hecho"

msgctxt "#11438"
msgid "Already done"
msgstr "Ya hecho"

msgctxt "#11439"
msgid "Setup is not finished. Run guided setup again to complete the steps marked Not done."
msgstr "La configuración aún no está terminada. Vuelve a ejecutar la configuración guiada para completar los pasos marcados como 'No hecho'."

msgctxt "#11440"
msgid "Spotify Client ID"
msgstr "Client ID de Spotify"

msgctxt "#11441"
msgid "Playback pairing"
msgstr "Vinculación de reproducción"

msgctxt "#11442"
msgid "Browser sign-in"
msgstr "Inicio de sesión en el navegador"

msgctxt "#11443"
msgid "Resonance is not fully set up yet. Finish setup now?"
msgstr "Resonance aún no está completamente configurado. ¿Terminar la configuración ahora?"

msgctxt "#11444"
msgid "Finish setup"
msgstr "Terminar configuración"

msgctxt "#11445"
msgid "Later"
msgstr "Más tarde"
