msgctxt "#11401"
msgid "Resonance setup"
msgstr "Configuration de Resonance"

msgctxt "#11402"
msgid "Welcome to Resonance.\n\nSetup takes a few minutes: a Spotify app Client ID, pairing this box for playback, and signing in to Spotify."
msgstr "Bienvenue dans Resonance.\n\nLa configuration prend quelques minutes : un Client ID Spotify, l'association de cet appareil pour la lecture et la connexion à Spotify."

msgctxt "#11403"
msgid "Continue Resonance setup?\n\nSteps you already finished are skipped."
msgstr "Poursuivre la configuration de Resonance ?\n\nLes étapes déjà terminées sont ignorées."

msgctxt "#11404"
msgid "Start"
msgstr "Démarrer"

msgctxt "#11405"
msgid "Skip"
msgstr "Ignorer"

msgctxt "#11406"
msgid "Step 1 of 3: Spotify app"
msgstr "Étape 1 sur 3 : application Spotify"

msgctxt "#11407"
msgid "Create a free app at developer.spotify.com/dashboard and add this Redirect URI:\n\n{}\n\nNext, enter the app's 32-character Client ID."
msgstr "Crée une application gratuite sur developer.spotify.com/dashboard et ajoute cette Redirect URI :\n\n{}\n\nEnsuite, saisis le Client ID de 32 caractères de l'application."

msgctxt "#11408"
msgid "Spotify Client ID"
msgstr "Client ID Spotify"

msgctxt "#11409"
msgid "That is not a valid Client ID. Run guided setup again from Settings."
msgstr "Ce n'est pas un Client ID valide. Relance la configuration guidée depuis les Paramètres."

msgctxt "#11410"
msgid "Step 2 of 3: Playback"
msgstr "Étape 2 sur 3 : lecture"

msgctxt "#11411"
msgid "Playback needs this box paired with Spotify once. The next screen waits for it."
msgstr "La lecture nécessite d'associer cet appareil à Spotify une fois. L'écran suivant attend cette étape."

msgctxt "#11412"
msgid "Step 3 of 3: Sign in"
msgstr "Étape 3 sur 3 : connexion"

msgctxt "#11413"
msgid "Sign in with Spotify in your browser for search and playlists."
msgstr "Connecte-toi à Spotify dans ton navigateur pour la recherche et les playlists."

msgctxt "#11414"
msgid "Setup complete. Search, playlists and playback are ready."
msgstr "Configuration terminée. Recherche, playlists et lecture sont prêtes."

msgctxt "#11415"
msgid "Waiting for Spotify to pair...\n\nOn your phone or PC, open Spotify, tap the speaker icon, and pick '{}'."
msgstr "En attente de l'association avec Spotify...\n\nSur ton téléphone ou PC, ouvre Spotify, appuie sur l'icône haut-parleur et choisis '{}'."

msgctxt "#11416"
msgid "Not paired yet.\n\nOn your phone or PC, open Spotify, tap the speaker icon, and pick '{}'. Then retry."
msgstr "Pas encore associé.\n\nSur ton téléphone ou PC, ouvre Spotify, appuie sur l'icône haut-parleur et choisis '{}'. Puis réessaie."

msgctxt "#11417"
msgid "Not paired yet. Open Spotify, tap the speaker icon, pick '{}', then try again."
msgstr "Pas encore associé. Ouvre Spotify, appuie sur l'icône haut-parleur, choisis '{}', puis réessaie."

msgctxt "#11418"
msgid "Retry"
msgstr "Réessayer"

msgctxt "#11419"
msgid "Cancel"
msgstr "Annuler"

msgctxt "#11420"
msgid "Next: enter your Spotify Client ID"
msgstr "Ensuite : saisis ton Client ID Spotify"

msgctxt "#11421"
msgid "Next: pair playback with Spotify"
msgstr "Ensuite : associe la lecture avec Spotify"

msgctxt "#11422"
msgid "Next: sign in for search and playlists"
msgstr "Ensuite : connecte-toi pour la recherche et les playlists"

msgctxt "#11423"
msgid "Reset Resonance"
msgstr "Réinitialiser Resonance"

msgctxt "#11424"
msgid "Clears Spotify sign-in, playback pairing, cache and setup choices. A backup is kept. Restart Kodi afterwards."
msgstr "Efface la connexion Spotify, l'association de lecture, le cache et les choix de configuration. Une sauvegarde est conservée. Redémarre Kodi ensuite."

msgctxt "#11425"
msgid "Reset Resonance? Spotify sign-in, playback pairing, the cache and setup choices are cleared. A backup is kept in the add-on data folder. Restart Kodi afterwards to finish."
msgstr "Réinitialiser Resonance ? La connexion Spotify, l'association de lecture, le cache et les choix de configuration sont effacés. Une sauvegarde est conservée dans le dossier de données du module. Redémarre Kodi ensuite pour terminer."

msgctxt "#11426"
msgid "Resonance was reset. Restart Kodi, then run guided setup."
msgstr "Resonance a été réinitialisé. Redémarre Kodi, puis lance la configuration guidée."

msgctxt "#11427"
msgid "Reset"
msgstr "Réinitialiser"

msgctxt "#11428"
msgid "Guided setup is already running."
msgstr "La configuration guidée est déjà en cours."

msgctxt "#11429"
msgid "Spotify Client ID saved."
msgstr "Client ID Spotify enregistré."

msgctxt "#11430"
msgid "The Client ID was not saved. It must be the 32 letters and numbers from your Spotify app. Run guided setup again to retry."
msgstr "Le Client ID n'a pas été enregistré. Il doit comporter les 32 lettres et chiffres de ton application Spotify. Relance la configuration guidée pour réessayer."

msgctxt "#11431"
msgid "Playback is paired with Spotify as '{}'."
msgstr "La lecture est associée à Spotify en tant que '{}'."

msgctxt "#11432"
msgid "Playback is not paired yet. Run guided setup again to finish pairing."
msgstr "La lecture n'est pas encore associée. Relance la configuration guidée pour terminer l'association."

msgctxt "#11433"
msgid "Signed in to Spotify. Search and playlists are ready."
msgstr "Connecté à Spotify. La recherche et les playlists sont prêtes."

msgctxt "#11434"
msgid "Browser sign-in did not finish. Run guided setup again to finish it."
msgstr "La connexion dans le navigateur n'a pas abouti. Relance la configuration guidée pour la terminer."

msgctxt "#11435"
msgid "Setup summary"
msgstr "Récapitulatif de la configuration"

msgctxt "#11436"
msgid "Done"
msgstr "Terminé"

msgctxt "#11437"
msgid "Not done"
msgstr "Non terminé"

msgctxt "#11438"
msgid "Already done"
msgstr "Déjà terminé"

msgctxt "#11439"
msgid "Setup is not finished. Run guided setup again to complete the steps marked Not done."
msgstr "La configuration n'est pas terminée. Relance la configuration guidée pour finir les étapes marquées « Non terminé »."

msgctxt "#11440"
msgid "Spotify Client ID"
msgstr "Client ID Spotify"

msgctxt "#11441"
msgid "Playback pairing"
msgstr "Association de la lecture"

msgctxt "#11442"
msgid "Browser sign-in"
msgstr "Connexion dans le navigateur"

msgctxt "#11443"
msgid "Resonance is not fully set up yet. Finish setup now?"
msgstr "Resonance n'est pas encore entièrement configuré. Terminer la configuration maintenant ?"

msgctxt "#11444"
msgid "Finish setup"
msgstr "Terminer la configuration"

msgctxt "#11445"
msgid "Later"
msgstr "Plus tard"
